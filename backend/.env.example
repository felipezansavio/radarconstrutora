# ---------------------------------------------------------------------------
# Radar Construtora IA — Backend (NestJS)
# Copie este arquivo para ".env" e preencha os valores para o seu ambiente.
# ---------------------------------------------------------------------------

# Aplicação
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Banco de dados (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radar_construtora?schema=public"

# Redis (cache e filas)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Autenticação (JWT)
JWT_SECRET=changeme-use-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mapas (escolher um provedor)
MAPS_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

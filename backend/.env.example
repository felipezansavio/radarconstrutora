# ---------------------------------------------------------------------------
# Radar Construtora IA — Backend (NestJS)
# Copie este arquivo para ".env" e preencha os valores para o seu ambiente.
# ---------------------------------------------------------------------------

# Aplicação
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Banco de dados (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radar_construtora?schema=public"

# Redis (cache e filas)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Autenticação (JWT)
JWT_SECRET=changeme-use-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_SECRET=changeme-use-a-different-long-random-secret
JWT_REFRESH_TOKEN_TTL=7d

# IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mapas (escolher um provedor)
MAPS_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Ingestão de dados externos (motor de busca de construtoras — Parte 8)
# Cada fonte é opcional: sem a chave, o provedor correspondente fica
# desativado e o motor de busca continua funcionando só com os dados
# já cadastrados na plataforma.
GOOGLE_PLACES_API_KEY=
NEWS_API_KEY=
REAL_ESTATE_PORTAL_API_KEY=
REAL_ESTATE_PORTAL_BASE_URL=

# E-mail transacional (alertas de oportunidades — Parte 11)
# Sem SMTP_HOST configurado, o envio de e-mail só é registrado em log e
# o monitoramento de oportunidades continua funcionando normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Radar Construtora IA <alertas@radar.local>"
SMTP_SECURE=false

# WhatsApp Business API (integração futura — Parte 11)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Monitoramento automático de oportunidades (Parte 11)
# Expressão cron do job diário que busca novos empreendimentos.
ALERTS_CRON_EXPRESSION="0 6 * * *"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Segurança (Parte 12)
# Protege /api/docs (Swagger) com autenticação básica. Sem as duas
# variáveis definidas, os docs só ficam expostos fora de produção.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Observabilidade futura (preparado, sem dependência adicionada ainda)
# SENTRY_DSN=
# DATADOG_API_KEY=

# ---------------------------------------------------------------------------
# Radar Construtora IA — Variáveis usadas pelo docker-compose.yml
# Copie este arquivo para ".env" na raiz do projeto para customizar a
# infraestrutura local. Os serviços backend/frontend também possuem seus
# próprios .env.example (backend/.env.example, frontend/.env.example).
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radar_construtora
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Portas expostas dos serviços de aplicação
BACKEND_PORT=3001
FRONTEND_PORT=3000

# URL pública da API usada no build do frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Token público do Mapbox usado no build do frontend (mapa interativo).
# Sem isso o mapa fica desabilitado ("Mapa não configurado").
# Crie um token gratuito em https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
